# Токен бота от @BotFather
BOT_TOKEN=123456789:replace-with-real-token

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Строка подключения SQLAlchemy; для Postgres: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///data/mwa_bot.db

# Канал для проверки подписки: @username или числовой id вида -100... По умолчанию @mwamethod.
# Бота нужно добавить в этот канал администратором, иначе Telegram не отдаёт список участников.
# off - проверка подписки выключена, проходят все (например, для тестового бота).
CHANNEL_ID=@mwamethod

# Канал MWA: кнопки «ПОДПИСАТЬСЯ НА MWA» и «TELEGRAM-КАНАЛ MWA»
CHANNEL_URL=https://t.me/mwamethod
# Кнопки финала: «ОТКРЫТЬ ПРОГРАММУ MWA» и «ОФОРМИТЬ УЧАСТИЕ» (заявка / оплата)
PROGRAM_URL=https://mwamethod.com/#program
APPLY_URL=https://mwamethod.com/#participation

# Telegram ID админов через запятую (узнать свой - @userinfobot): у них в боте есть
# команда /admin с рассылкой всем пользователям; ещё они могут присылать боту видео для дней.
ADMIN_IDS=

# Пауза между днями в минутах: 1440 = 24 часа. Для проверки можно поставить 2.
DAY_INTERVAL_MINUTES=1440

# Публичный адрес бота для режима webhook (например https://mwa-bot.onrender.com).
# Пусто - бот сам забирает апдейты (polling), так удобно запускать локально.
# На Render не нужен: адрес берётся из RENDER_EXTERNAL_URL, который Render выставляет сам.
WEBHOOK_BASE_URL=
# Порт HTTP-сервера в режиме webhook; Render задаёт PORT сам.
PORT=8080
